      "clientAuthenticatorType": "client-secret",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
