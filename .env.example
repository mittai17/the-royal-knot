# Copy to .env for local compose, or paste into Dokploy -> Environment. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# Routing
APP_DOMAIN=royalknot.example.com        # host Traefik routes to the frontend
PUBLIC_URL=https://royalknot.example.com # used for CORS
TRAEFIK_ENTRYPOINT=websecure             # `web` for plain HTTP / local
COOKIE_SECURE=true                       # false only when serving over plain HTTP

# Database
POSTGRES_USER=royalknot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=royalknot

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Object storage
MINIO_ROOT_USER=royalknot
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=royalknot

# Mail (Mailpit is the local SMTP sink)
MAIL_FROM=no-reply@royalknot.local

# Set to true for the FIRST deploy to load demo data, then back to false.
SEED_ON_START=false
