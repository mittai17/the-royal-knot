generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FOUNDER
  PLANNER
  EVENT_MANAGER
  FINANCE
  OPERATIONS
  CLIENT
  VENDOR
  SYSADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EnquirySource {
  PHONE
  INSTAGRAM
  WHATSAPP
  WEBSITE
  REFERRAL
  OTHER
}

enum EnquiryStage {
  NEW
  INITIAL_CONSULTATION
  PROPOSAL_SENT
  NEGOTIATION
  CONVERTED
  LOST
}

enum PackageType {
  FULL_SERVICE
  PARTIAL
}

enum WeddingStatus {
  PLANNING
  VENDOR_BOOKING
  EVENT_DAY
  COMPLETED
  CANCELLED
}

enum EventKind {
  MEHENDI
  SANGEET
  CEREMONY
  RECEPTION
  HALDI
  OTHER
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  REJECTED
  EXPIRED
}

enum VendorCategory {
  CATERING
  DECORATION
  PHOTOGRAPHY
  VIDEOGRAPHY
  VENUE
  MAKEUP
  DRUMMERS
  ENTERTAINMENT
  TRANSPORTATION
  ACCOMMODATION
  LIGHTING
  SOUND
  OTHER
}

/// One canonical lifecycle for RFQ requests and quotations (MASTER_SPEC section 9).
enum QuotationStatus {
  DRAFT
  SENT
  RECEIVED
  UNDER_REVIEW
  COMPARED
  SELECTED
  REJECTED
  CLOSED
  EXPIRED
}

enum TaskCategory {
  VENUE
  DESIGN
  DECORATION
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  GUEST_MANAGEMENT
  ACCOMMODATION
  TRANSPORTATION
  ENTERTAINMENT
  MEHENDI
  SANGEET
  CEREMONY
  RECEPTION
  FINAL_PREPARATION
}

enum TaskStatus {
  TO_PLAN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RSVP {
  PENDING
  CONFIRMED
  DECLINED
}

enum InvitationStatus {
  NOT_SENT
  SENT
  DELIVERED
}

enum MilestoneType {
  BOOKING
  ADVANCE
  FINAL
}

enum MilestoneStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum VendorPaymentKind {
  ADVANCE
  FINAL
}

/// Client payment lifecycle (MASTER_SPEC section 9).
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Vendor payment lifecycle (MASTER_SPEC section 7); separate from VendorBillStatus.
enum VendorPaymentStatus {
  REQUESTED
  APPROVED
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

/// Wedding booking lifecycle: a wedding is a booking only once CONFIRMED (agreement signed + proposal accepted + deposit verified).
enum BookingStatus {
  DRAFT
  AGREEMENT_PENDING
  PROPOSAL_PENDING
  DEPOSIT_PENDING
  CONFIRMED
  CANCELLED
}

enum ExecutionStage {
  INITIAL_PHASE
  VENDOR_BOOKING
  PLANNING
  EVENT_DAY
  FINANCIAL_CLOSEOUT
  COMPLETED
}

/// Wedding-level money status, kept separate from booking and execution.
enum WeddingFinancialStatus {
  NOT_STARTED
  DEPOSIT_PENDING
  PARTIALLY_PAID
  FULLY_PAID
  OVERDUE
  CLOSED
}

enum EventFunctionStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FieldReportType {
  DAILY
  TASK
  EVENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SettlementStatus {
  PENDING
  PARTIAL
  SETTLED
}

enum ReconciliationStatus {
  OPEN
  CLOSED
}

enum ChargeType {
  EXTRA_GUESTS
  DECORATION
  DJ_OVERTIME
  EQUIPMENT
  TRANSPORTATION
  OTHER
}

enum TimelineStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum ArrivalStatus {
  EXPECTED
  ON_THE_WAY
  ARRIVED
  DELAYED
  COMPLETED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentCategory {
  AGREEMENT
  VENDOR_QUOTATION
  VENDOR_CONTRACT
  FLOOR_PLAN
  EVENT_SCHEDULE
  INVOICE
  RECEIPT
  FINAL_REPORT
  PHOTO
  EVIDENCE
  OTHER
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String
  phone              String?
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  available          Boolean    @default(true)
  monthlyCost        Decimal    @default(0) @db.Decimal(14, 2)
  lastLoginAt        DateTime?
  /// VENDOR users: the vendor record they act for.
  vendorId           String?
  vendor             Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// CLIENT users: the couple (and therefore the wedding(s)) they may see.
  coupleId           String?
  couple             Couple?    @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  /// Per-user notification preferences (channels / categories), replaces the SystemSetting `user.prefs.<id>` workaround.
  notificationPrefs  Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  messages           Message[]
  threadMembers      MessageThreadMember[]
  approvalsRequested Approval[]            @relation("ApprovalRequester")
  approvalsDecided   Approval[]            @relation("ApprovalDecider")
  refreshTokens      RefreshToken[]
  teamMembers        TeamMember[]
  enquiries          Enquiry[]
  weddings           Wedding[]
  tasks              WeddingTask[]
  notifications      Notification[]
  incidents          Incident[]
  expenses           Expense[]
  documents          Document[]
  activity           ActivityLog[]
  approvalsAssigned  Approval[]            @relation("ApprovalAssignee")
  feedbackReplies    FeedbackReply[]
  announcementReads  AnnouncementRead[]
  fieldReports       FieldReport[]

  @@index([vendorId])
  @@index([coupleId])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

model Team {
  id      String       @id @default(uuid())
  name    String       @unique
  members TeamMember[]
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Couple {
  id        String    @id @default(uuid())
  brideName String
  groomName String
  phone     String?
  email     String?
  address   String?
  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  enquiries Enquiry[]
  weddings  Wedding[]
  users     User[]
}

model Enquiry {
  id                 String            @id @default(uuid())
  coupleId           String
  couple             Couple            @relation(fields: [coupleId], references: [id])
  source             EnquirySource     @default(OTHER)
  stage              EnquiryStage      @default(NEW)
  preferredDate      DateTime?
  location           String?
  guestCount         Int?
  budget             Decimal?          @db.Decimal(14, 2)
  theme              String?
  packageType        PackageType       @default(FULL_SERVICE)
  assignedToId       String?
  assignedTo         User?             @relation(fields: [assignedToId], references: [id])
  followUpAt         DateTime?
  notes              String?
  lostReason         String?
  convertedWeddingId String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  activities         EnquiryActivity[]

  @@index([stage])
  @@index([assignedToId])
  @@index([followUpAt])
}

model EnquiryActivity {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actorId   String?
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([enquiryId])
}

model Wedding {
  id              String                 @id @default(uuid())
  name            String
  coupleId        String
  couple          Couple                 @relation(fields: [coupleId], references: [id])
  enquiryId       String?                @unique
  location        String
  venue           String?
  startDate       DateTime
  endDate         DateTime
  eventDays       Int                    @default(3)
  expectedGuests  Int                    @default(0)
  actualGuests    Int?
  packageType     PackageType            @default(FULL_SERVICE)
  budget          Decimal                @default(0) @db.Decimal(14, 2)
  contractValue   Decimal                @default(0) @db.Decimal(14, 2)
  plannerId       String?
  planner         User?                  @relation(fields: [plannerId], references: [id])
  /// Legacy combined status; kept working until the code moves to bookingStatus + executionStage.
  status          WeddingStatus          @default(PLANNING)
  bookingStatus   BookingStatus          @default(DRAFT)
  executionStage  ExecutionStage         @default(INITIAL_PHASE)
  financialStatus WeddingFinancialStatus @default(NOT_STARTED)
  /// The couple's "Our story" text (client portal).
  story           String?
  theme           String?
  coverImage      String?
  isDemo          Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  events          WeddingEvent[]
  agreements      Agreement[]
  weddingVendors  WeddingVendor[]
  requests        QuotationRequest[]
  tasks           WeddingTask[]
  guests          Guest[]
  milestones      PaymentMilestone[]
  clientPayments  ClientPayment[]
  vendorPayments  VendorPayment[]
  expenses        Expense[]
  budgetLines     BudgetLine[]
  reconciliation  Reconciliation?
  timeline        TimelineItem[]
  incidents       Incident[]
  documents       Document[]
  activity        ActivityLog[]
  approvals       Approval[]
  purchaseOrders  PurchaseOrder[]
  clientInvoices  ClientInvoice[]
  vendorBills     VendorBill[]
  budgets         Budget[]
  roomAllocations RoomAllocation[]
  trips           Trip[]
  threads         MessageThread[]
  announcements   Announcement[]
  feedback        FeedbackRequest[]
  media           MediaAsset[]
  checklists      Checklist[]
  proposals       Proposal[]
  reviews         VendorReview[]
  fieldReports    FieldReport[]

  @@index([status])
  @@index([bookingStatus])
  @@index([executionStage])
  @@index([startDate])
  @@index([plannerId])
}

model WeddingEvent {
  id             String              @id @default(uuid())
  weddingId      String
  wedding        Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  kind           EventKind
  name           String
  date           DateTime
  endAt          DateTime?
  venue          String?
  expectedGuests Int                 @default(0)
  status         EventFunctionStatus @default(UPCOMING)
  notes          String?
  tasks          WeddingTask[]
  timeline       TimelineItem[]
  vendors        EventVendor[]
  checklists     Checklist[]
  fieldReports   FieldReport[]

  @@index([weddingId])
}

/// Which booked vendors work a given event function.
model EventVendor {
  id              String        @id @default(uuid())
  eventId         String
  event           WeddingEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weddingVendorId String
  weddingVendor   WeddingVendor @relation(fields: [weddingVendorId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([eventId, weddingVendorId])
  @@index([weddingVendorId])
}

model AgreementTemplate {
  id          String      @id @default(uuid())
  name        String      @unique
  packageType PackageType
  body        String
  createdAt   DateTime    @default(now())
  agreements  Agreement[]
}

model Agreement {
  id           String               @id @default(uuid())
  weddingId    String
  wedding      Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  templateId   String
  template     AgreementTemplate    @relation(fields: [templateId], references: [id])
  version      Int                  @default(1)
  status       AgreementStatus      @default(DRAFT)
  content      String
  amount       Decimal              @db.Decimal(14, 2)
  paymentTerms String
  documentId   String?
  expiresAt    DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  createdAt    DateTime             @default(now())
  signatures   AgreementSignature[]

  @@unique([weddingId, version])
}

model AgreementSignature {
  id            String    @id @default(uuid())
  agreementId   String
  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  signerName    String
  signerRole    String
  signatureData String
  signedAt      DateTime  @default(now())
  ip            String?

  @@index([agreementId])
}

model Vendor {
  id                String         @id @default(uuid())
  name              String
  businessName      String?
  category          VendorCategory
  contactName       String
  phone             String
  email             String?
  address           String?
  serviceAreas      String[]
  basePrice         Decimal?       @db.Decimal(14, 2)
  priceUnit         String?
  available         Boolean        @default(true)
  rating            Decimal        @default(4) @db.Decimal(3, 2)
  gstin             String?
  bankDetails       String?
  active            Boolean        @default(true)
  /// Availability calendar (replaces the SystemSetting `vendor.availability.<id>` workaround).
  blockedDates      DateTime[]
  availabilityNotes String?
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now())

  services       VendorService[]
  weddingVendors WeddingVendor[]
  requests       QuotationRequest[]
  expenses       Expense[]
  users          User[]
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]
  reviews        VendorReview[]
  drivers        Driver[]

  @@index([category])
}

model VendorService {
  id       String  @id @default(uuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name     String
  unit     String
  price    Decimal @db.Decimal(14, 2)
}

model WeddingVendor {
  id               String         @id @default(uuid())
  weddingId        String
  wedding          Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  category         VendorCategory
  contractAmount   Decimal        @default(0) @db.Decimal(14, 2)
  negotiatedAmount Decimal?       @db.Decimal(14, 2)
  quotationId      String?
  notes            String?
  createdAt        DateTime       @default(now())

  arrival          VendorArrival?
  payments         VendorPayment[]
  settlement       VendorSettlement?
  tasks            WeddingTask[]
  deliverables     VendorDeliverable[]
  eventAssignments EventVendor[]

  @@unique([weddingId, vendorId, category])
  @@index([weddingId])
}

/// Done / not-done state of a booked vendor's service deliverables (checklist derived from the accepted quotation's lines).
model VendorDeliverable {
  id              String         @id @default(uuid())
  weddingVendorId String
  weddingVendor   WeddingVendor  @relation(fields: [weddingVendorId], references: [id], onDelete: Cascade)
  quotationItemId String?
  quotationItem   QuotationItem? @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)
  title           String
  done            Boolean        @default(false)
  doneAt          DateTime?
  doneById        String?
  note            String?
  createdAt       DateTime       @default(now())

  @@unique([weddingVendorId, quotationItemId])
  @@index([weddingVendorId])
}

model QuotationRequest {
  id        String          @id @default(uuid())
  rfqGroup  String
  weddingId String
  wedding   Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  category  VendorCategory
  title     String
  brief     String?
  status    QuotationStatus @default(SENT)
  closedAt  DateTime?
  createdAt DateTime        @default(now())
  quotation Quotation?

  @@unique([rfqGroup, vendorId])
  @@index([weddingId, category])
  @@index([rfqGroup])
}

model Quotation {
  id              String           @id @default(uuid())
  requestId       String           @unique
  request         QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status          QuotationStatus  @default(RECEIVED)
  menu            String?
  guests          Int?
  guestCapacity   Int?
  ratePerPlate    Decimal?         @db.Decimal(14, 2)
  extraHourCharge Decimal?         @db.Decimal(14, 2)
  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal          @default(0) @db.Decimal(14, 2)
  additionalTotal Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal          @default(0) @db.Decimal(14, 2)
  pricePerPlate   Decimal?         @db.Decimal(14, 2)
  rating          Int?
  notes           String?
  validUntil      DateTime?
  decisionNote    String?
  createdAt       DateTime         @default(now())
  items           QuotationItem[]
}

model QuotationItem {
  id               String              @id @default(uuid())
  quotationId      String
  quotation        Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  quantity         Decimal             @db.Decimal(12, 2)
  unit             String
  unitPrice        Decimal             @db.Decimal(14, 2)
  taxRate          Decimal             @default(0) @db.Decimal(5, 2)
  additionalCharge Decimal             @default(0) @db.Decimal(14, 2)
  included         Boolean             @default(true)
  total            Decimal             @db.Decimal(14, 2)
  deliverables     VendorDeliverable[]

  @@index([quotationId])
}

model TaskTemplate {
  id        String             @id @default(uuid())
  name      String             @unique
  isDefault Boolean            @default(false)
  items     TaskTemplateItem[]
}

model TaskTemplateItem {
  id             String          @id @default(uuid())
  templateId     String
  template       TaskTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String
  category       TaskCategory
  offsetDays     Int
  priority       Priority        @default(MEDIUM)
  ownerRole      Role            @default(PLANNER)
  dependsOnKey   String?
  eventKind      EventKind?
  vendorCategory VendorCategory?
  sortOrder      Int             @default(0)

  @@unique([templateId, key])
}

model WeddingTask {
  id                 String         @id @default(uuid())
  weddingId          String
  wedding            Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  templateKey        String?
  name               String
  description        String
  category           TaskCategory
  ownerId            String?
  owner              User?          @relation(fields: [ownerId], references: [id])
  dueDate            DateTime
  priority           Priority       @default(MEDIUM)
  status             TaskStatus     @default(TO_PLAN)
  vendorId           String?
  weddingVendor      WeddingVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  eventId            String?
  event              WeddingEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  evidenceNote       String?
  evidenceDocumentId String?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  dependsOn  TaskDependency[] @relation("TaskDeps")
  dependents TaskDependency[] @relation("TaskDependents")

  @@unique([weddingId, templateKey])
  @@index([weddingId, status])
  @@index([ownerId, status])
  @@index([dueDate])
}

model TaskDependency {
  id          String      @id @default(uuid())
  taskId      String
  task        WeddingTask @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   WeddingTask @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Guest {
  id                  String           @id @default(uuid())
  weddingId           String
  wedding             Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  email               String?
  groupName           String?
  category            String?
  invitationStatus    InvitationStatus @default(NOT_SENT)
  rsvp                RSVP             @default(PENDING)
  plusOnes            Int              @default(0)
  dietary             String?
  accommodationNeeded Boolean          @default(false)
  checkedIn           Boolean          @default(false)
  checkedInAt         DateTime?
  checkedInCount      Int              @default(0)
  createdAt           DateTime         @default(now())
  roomAllocations     RoomAllocation[]
  trips               GuestTransport[]

  @@index([weddingId, rsvp])
  @@index([weddingId, checkedIn])
  @@index([weddingId, groupName])
}

model PaymentMilestone {
  id             String          @id @default(uuid())
  weddingId      String
  wedding        Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type           MilestoneType
  dueDate        DateTime
  expectedAmount Decimal         @db.Decimal(14, 2)
  status         MilestoneStatus @default(UPCOMING)
  payments       ClientPayment[]

  @@unique([weddingId, type])
}

model ClientPayment {
  id             String           @id @default(uuid())
  weddingId      String
  /// Posted money is never cascade-deleted with its wedding: Restrict.
  wedding        Wedding          @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  milestoneId    String
  milestone      PaymentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  /// Optional link to the client invoice this payment settles.
  invoiceId      String?
  invoice        ClientInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount         Decimal          @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  paidAt         DateTime
  idempotencyKey String           @unique
  receiptNo      String           @unique
  recordedById   String?
  status         PaymentStatus    @default(SUCCEEDED)
  /// Payment gateway reference / callback id (idempotent webhook handling).
  gatewayRef     String?
  /// Deposit / payment verification (finance confirms funds received).
  verifiedAt     DateTime?
  verifiedById   String?
  /// Reversal support: a correction/refund is a new row pointing at the original; the original is never edited away.
  reversalOfId   String?
  reversalOf     ClientPayment?   @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      ClientPayment[]  @relation("PaymentReversal")
  reversedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([weddingId])
  @@index([milestoneId])
  @@index([invoiceId])
  @@index([status])
  @@index([reversalOfId])
}

model VendorPayment {
  id              String              @id @default(uuid())
  weddingId       String
  wedding         Wedding             @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  weddingVendorId String
  weddingVendor   WeddingVendor       @relation(fields: [weddingVendorId], references: [id], onDelete: Restrict)
  kind            VendorPaymentKind
  amount          Decimal             @db.Decimal(14, 2)
  method          PaymentMethod
  reference       String?
  /// Set when the payment is executed (null while REQUESTED / APPROVED / SCHEDULED).
  paidAt          DateTime?
  idempotencyKey  String              @unique
  recordedById    String?
  status          VendorPaymentStatus @default(PAID)
  /// Vendor bill this payment settles (optional: advances are paid against the contract).
  billId          String?
  bill            VendorBill?         @relation(fields: [billId], references: [id], onDelete: Restrict)
  requestedById   String?
  requestedAt     DateTime            @default(now())
  approvedById    String?
  approvedAt      DateTime?
  approvalId      String?
  approval        Approval?           @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  scheduledFor    DateTime?
  failureReason   String?
  notes           String?
  /// Reversal support: a correction/refund is a new row pointing at the original.
  reversalOfId    String?
  reversalOf      VendorPayment?      @relation("VendorPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       VendorPayment[]     @relation("VendorPaymentReversal")
  reversedAt      DateTime?
  createdAt       DateTime            @default(now())
  billPayments    VendorBillPayment[]

  @@index([weddingId])
  @@index([weddingVendorId])
  @@index([status])
  @@index([billId])
  @@index([reversalOfId])
}

model BudgetLine {
  id            String  @id @default(uuid())
  weddingId     String
  wedding       Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category      String
  plannedAmount Decimal @db.Decimal(14, 2)

  @@unique([weddingId, category])
}

model Expense {
  id                String         @id @default(uuid())
  weddingId         String
  wedding           Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?        @relation(fields: [vendorId], references: [id])
  category          String
  description       String
  amount            Decimal        @db.Decimal(14, 2)
  date              DateTime
  method            PaymentMethod  @default(BANK_TRANSFER)
  receiptDocumentId String?
  status            ApprovalStatus @default(PENDING)
  responsibleId     String?
  responsible       User?          @relation(fields: [responsibleId], references: [id])
  isTeamCost        Boolean        @default(false)
  /// Reversal / correction entry support.
  reversalOfId      String?
  reversalOf        Expense?       @relation("ExpenseReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals         Expense[]      @relation("ExpenseReversal")
  reversedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@index([weddingId, status])
  @@index([category])
}

model Reconciliation {
  id          String               @id @default(uuid())
  weddingId   String               @unique
  wedding     Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  status      ReconciliationStatus @default(OPEN)
  closedAt    DateTime?
  createdAt   DateTime             @default(now())
  settlements VendorSettlement[]
  charges     AdditionalCharge[]
}

model VendorSettlement {
  id               String           @id @default(uuid())
  reconciliationId String
  reconciliation   Reconciliation   @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  weddingVendorId  String           @unique
  weddingVendor    WeddingVendor    @relation(fields: [weddingVendorId], references: [id], onDelete: Cascade)
  originalQuoted   Decimal          @db.Decimal(14, 2)
  negotiated       Decimal          @db.Decimal(14, 2)
  actualInvoice    Decimal?         @db.Decimal(14, 2)
  invoiceRef       String?
  status           SettlementStatus @default(PENDING)
  settledAt        DateTime?
}

model AdditionalCharge {
  id               String         @id @default(uuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  weddingVendorId  String?
  type             ChargeType
  description      String
  quantity         Decimal        @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(14, 2)
  amount           Decimal        @db.Decimal(14, 2)
  approved         Boolean        @default(false)
  billToClient     Boolean        @default(true)
  auto             Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([reconciliationId])
}

model TimelineItem {
  id           String         @id @default(uuid())
  weddingId    String
  wedding      Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId      String?
  event        WeddingEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title        String
  scheduledAt  DateTime
  actualAt     DateTime?
  responsible  String?
  team         String?
  notes        String?
  delayMinutes Int            @default(0)
  status       TimelineStatus @default(SCHEDULED)
  createdAt    DateTime       @default(now())

  @@index([weddingId, scheduledAt])
}

model VendorArrival {
  id              String        @id @default(uuid())
  weddingVendorId String        @unique
  weddingVendor   WeddingVendor @relation(fields: [weddingVendorId], references: [id], onDelete: Cascade)
  weddingId       String
  expectedAt      DateTime
  actualAt        DateTime?
  status          ArrivalStatus @default(EXPECTED)
  delayMinutes    Int           @default(0)
  contactName     String?
  contactPhone    String?
  notes           String?

  @@index([weddingId])
}

model Incident {
  id           String         @id @default(uuid())
  weddingId    String
  wedding      Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title        String
  description  String
  severity     Severity       @default(MEDIUM)
  assignedToId String?
  assignedTo   User?          @relation(fields: [assignedToId], references: [id])
  status       IncidentStatus @default(REPORTED)
  resolution   String?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  @@index([weddingId, status])
}

model Document {
  id                 String           @id @default(uuid())
  weddingId          String?
  wedding            Wedding?         @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  name               String
  category           DocumentCategory @default(OTHER)
  objectKey          String           @unique
  mimeType           String
  size               Int
  documentKey        String
  version            Int              @default(1)
  allowedRoles       Role[]
  uploadedById       String?
  uploadedBy         User?            @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime         @default(now())
  approvalsSupported Approval[]

  @@unique([documentKey, version])
  @@index([weddingId, category])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String?
  action    String
  message   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([weddingId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

// =====================================================================
//  WedFlow foundation: cross-cutting modules (see docs/WEDFLOW_SPEC.md)
// =====================================================================

enum ApprovalType {
  VENDOR_CONTRACT
  EXTRA_EXPENSE
  CLIENT_DISCOUNT
  VENDOR_PAYMENT
  BUDGET_INCREASE
  OTHER
}

enum ApprovalState {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  FULFILLED
  CANCELLED
}

/// OVERDUE is derived at read time (never required to be persisted).
enum ClientInvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  REJECTED
}

enum RoomAllocationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GuestTransportStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  DROPPED
  CANCELLED
}

enum ThreadChannel {
  CLIENT
  VENDOR
  TEAM
  PLANNER
}

enum FeedbackKind {
  REQUEST
  FEEDBACK
  SUPPORT
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum MediaKind {
  PHOTO
  VIDEO
  REFERENCE
  FILE
}

model Approval {
  id                   String          @id @default(uuid())
  /// Human readable reference, e.g. APR-2026-0001.
  reference            String?         @unique
  type                 ApprovalType
  status               ApprovalState   @default(PENDING)
  title                String
  description          String?
  amount               Decimal?        @db.Decimal(14, 2)
  weddingId            String?
  wedding              Wedding?        @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  /// Polymorphic pointer to the thing being approved (entity name + id), e.g. Expense / VendorPayment / WeddingVendor.
  entity               String?
  entityId             String?
  requestedById        String?
  requestedBy          User?           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById          String?
  decidedBy            User?           @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote         String?
  decidedAt            DateTime?
  /// Why the approval is needed (the justification entered by the requester).
  reason               String?
  supportingDocumentId String?
  supportingDocument   Document?       @relation(fields: [supportingDocumentId], references: [id], onDelete: SetNull)
  /// Who is expected to decide (maker-checker routing); decidedBy records who actually did.
  assignedApproverId   String?
  assignedApprover     User?           @relation("ApprovalAssignee", fields: [assignedApproverId], references: [id], onDelete: SetNull)
  /// Source module / record (e.g. "vendor-payments" + payment id); entity / entityId remain for existing code.
  sourceModule         String?
  sourceId             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  vendorPayments       VendorPayment[]

  @@index([sourceModule, sourceId])
  @@index([assignedApproverId])
  @@index([status, type])
  @@index([weddingId])
  @@index([entity, entityId])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  weddingId   String
  wedding     Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  quotationId String?
  status      PurchaseOrderStatus @default(DRAFT)
  subtotal    Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal             @default(0) @db.Decimal(14, 2)
  total       Decimal             @default(0) @db.Decimal(14, 2)
  terms       String?
  issuedAt    DateTime?
  expectedBy  DateTime?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       PurchaseOrderLine[]
  bills       VendorBill[]

  @@index([weddingId])
  @@index([vendorId, status])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Decimal       @default(1) @db.Decimal(14, 2)
  unit            String        @default("unit")
  unitPrice       Decimal       @db.Decimal(14, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  total           Decimal       @db.Decimal(14, 2)

  @@index([purchaseOrderId])
}

model ClientInvoice {
  id             String              @id @default(uuid())
  invoiceNo      String              @unique
  weddingId      String
  wedding        Wedding             @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  milestoneId    String?
  status         ClientInvoiceStatus @default(DRAFT)
  issueDate      DateTime            @default(now())
  dueDate        DateTime?
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal             @default(0) @db.Decimal(14, 2)
  discount       Decimal             @default(0) @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal             @default(0) @db.Decimal(14, 2)
  notes          String?
  sentAt         DateTime?
  lastReminderAt DateTime?
  documentId     String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          ClientInvoiceLine[]
  payments       ClientPayment[]

  @@index([weddingId, status])
  @@index([dueDate])
}

model ClientInvoiceLine {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal       @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal       @db.Decimal(14, 2)
  taxRate     Decimal       @default(0) @db.Decimal(5, 2)
  total       Decimal       @db.Decimal(14, 2)

  @@index([invoiceId])
}

model VendorBill {
  id              String              @id @default(uuid())
  billNo          String
  weddingId       String?
  wedding         Wedding?            @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  status          VendorBillStatus    @default(SUBMITTED)
  billDate        DateTime            @default(now())
  dueDate         DateTime?
  subtotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal             @default(0) @db.Decimal(14, 2)
  total           Decimal             @db.Decimal(14, 2)
  amountPaid      Decimal             @default(0) @db.Decimal(14, 2)
  documentId      String?
  notes           String?
  submittedById   String?
  verifiedById    String?
  approvedById    String?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payments        VendorBillPayment[]
  vendorPayments  VendorPayment[]

  @@unique([vendorId, billNo])
  @@index([status, dueDate])
  @@index([weddingId])
}

/// Payments applied to a vendor bill (replaces ActivityLog `pay` entries as the idempotency record).
model VendorBillPayment {
  id              String              @id @default(uuid())
  billId          String
  bill            VendorBill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount          Decimal             @db.Decimal(14, 2)
  method          PaymentMethod
  reference       String?
  paidAt          DateTime            @default(now())
  idempotencyKey  String              @unique
  vendorPaymentId String?
  vendorPayment   VendorPayment?      @relation(fields: [vendorPaymentId], references: [id], onDelete: SetNull)
  recordedById    String?
  reversalOfId    String?
  reversalOf      VendorBillPayment?  @relation("BillPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       VendorBillPayment[] @relation("BillPaymentReversal")
  reversedAt      DateTime?
  createdAt       DateTime            @default(now())

  @@index([billId])
  @@index([vendorPaymentId])
}

model Budget {
  id          String       @id @default(uuid())
  weddingId   String
  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name        String       @default("Working budget")
  version     Int          @default(1)
  total       Decimal      @default(0) @db.Decimal(14, 2)
  notes       String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       BudgetItem[]

  @@unique([weddingId, version])
}

model BudgetItem {
  id              String  @id @default(uuid())
  budgetId        String
  budget          Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category        String
  description     String?
  plannedAmount   Decimal @db.Decimal(14, 2)
  committedAmount Decimal @default(0) @db.Decimal(14, 2)
  actualAmount    Decimal @default(0) @db.Decimal(14, 2)

  @@index([budgetId])
}

model Hotel {
  id         String   @id @default(uuid())
  name       String
  city       String?
  address    String?
  phone      String?
  email      String?
  starRating Int?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  rooms      Room[]

  @@index([city])
}

model Room {
  id          String           @id @default(uuid())
  hotelId     String
  hotel       Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number      String
  type        String           @default("Standard")
  capacity    Int              @default(2)
  rate        Decimal          @default(0) @db.Decimal(14, 2)
  active      Boolean          @default(true)
  allocations RoomAllocation[]

  @@unique([hotelId, number])
}

model RoomAllocation {
  id           String               @id @default(uuid())
  weddingId    String
  wedding      Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  roomId       String
  room         Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestId      String?
  guest        Guest?               @relation(fields: [guestId], references: [id], onDelete: SetNull)
  status       RoomAllocationStatus @default(CONFIRMED)
  checkIn      DateTime
  checkOut     DateTime
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  notes        String?
  createdAt    DateTime             @default(now())

  @@index([weddingId, status])
  @@index([roomId, checkIn])
  @@index([guestId])
}

model Vehicle {
  id         String   @id @default(uuid())
  plate      String   @unique
  type       String   @default("Sedan")
  capacity   Int      @default(4)
  vendorName String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  trips      Trip[]
}

model Driver {
  id        String   @id @default(uuid())
  name      String
  phone     String
  licenseNo String?
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Trip {
  id          String           @id @default(uuid())
  weddingId   String
  wedding     Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId    String?
  driver      Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  title       String
  origin      String
  destination String
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  status      TripStatus       @default(SCHEDULED)
  notes       String?
  createdAt   DateTime         @default(now())
  passengers  GuestTransport[]

  @@index([weddingId, scheduledAt])
  @@index([vehicleId])
  @@index([driverId])
}

model GuestTransport {
  id            String               @id @default(uuid())
  guestId       String
  guest         Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tripId        String?
  trip          Trip?                @relation(fields: [tripId], references: [id], onDelete: SetNull)
  kind          String               @default("PICKUP")
  flightOrTrain String?
  arrivalAt     DateTime?
  status        GuestTransportStatus @default(PENDING)
  passengers    Int                  @default(1)
  notes         String?
  createdAt     DateTime             @default(now())

  @@index([guestId])
  @@index([tripId])
}

model MessageThread {
  id            String                @id @default(uuid())
  channel       ThreadChannel
  subject       String
  weddingId     String?
  wedding       Wedding?              @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  /// For VENDOR threads: the vendor this thread is with (vendor users only see their own).
  vendorId      String?
  createdById   String?
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  members       MessageThreadMember[]
  messages      Message[]

  @@index([weddingId, channel])
  @@index([vendorId])
  @@index([lastMessageAt])
}

model MessageThreadMember {
  id         String        @id @default(uuid())
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id                    String        @id @default(uuid())
  threadId              String
  thread                MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId              String
  sender                User          @relation(fields: [senderId], references: [id])
  body                  String
  attachmentDocumentIds String[]
  createdAt             DateTime      @default(now())

  @@index([threadId, createdAt])
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  body        String
  weddingId   String?
  wedding     Wedding?           @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  /// Audience roles; empty = everyone relevant to the wedding.
  audience    Role[]
  vendorId    String?
  pinned      Boolean            @default(false)
  publishedAt DateTime           @default(now())
  expiresAt   DateTime?
  authorId    String?
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]

  @@index([weddingId, publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

model FeedbackRequest {
  id                    String          @id @default(uuid())
  kind                  FeedbackKind    @default(REQUEST)
  status                FeedbackStatus  @default(OPEN)
  weddingId             String?
  wedding               Wedding?        @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  submittedById         String?
  subject               String
  body                  String
  /// Category (previously encoded as a `[Category] ` prefix of subject).
  category              String?
  rating                Int?
  attachmentDocumentIds String[]
  response              String?
  assignedToId          String?
  resolvedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  replies               FeedbackReply[]

  @@index([weddingId, status])
  @@index([submittedById])
  @@index([category])
}

/// Full reply history (the single `response` string keeps the latest staff reply for existing readers).
model FeedbackReply {
  id         String          @id @default(uuid())
  feedbackId String
  feedback   FeedbackRequest @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime        @default(now())

  @@index([feedbackId, createdAt])
}

model MediaAsset {
  id            String    @id @default(uuid())
  weddingId     String?
  wedding       Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  kind          MediaKind @default(PHOTO)
  title         String?
  objectKey     String    @unique
  mimeType      String
  size          Int
  album         String?
  uploadedById  String?
  clientVisible Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([weddingId, album])
}

model Checklist {
  id            String          @id @default(uuid())
  name          String
  weddingId     String?
  wedding       Wedding?        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  ownerId       String?
  /// Visible to the client portal when true.
  clientVisible Boolean         @default(false)
  /// Optional: the event function this checklist belongs to.
  eventId       String?
  event         WeddingEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  items         ChecklistItem[]

  @@index([weddingId])
  @@index([eventId])
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneById    String?
  dueDate     DateTime?
  sortOrder   Int       @default(0)

  @@index([checklistId])
}

model Proposal {
  id          String         @id @default(uuid())
  title       String
  weddingId   String?
  wedding     Wedding?       @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  enquiryId   String?
  packageName String?
  status      ProposalStatus @default(DRAFT)
  amount      Decimal        @default(0) @db.Decimal(14, 2)
  content     String?
  validUntil  DateTime?
  sentAt      DateTime?
  respondedAt DateTime?
  createdById String?
  agreementId String?
  /// Agreement template chosen when the proposal is sent.
  templateId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([weddingId])
  @@index([enquiryId])
}

model VendorReview {
  id          String    @id @default(uuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  weddingId   String?
  wedding     Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  reviewerId  String?
  rating      Int
  punctuality Int?
  comment     String?
  /// The vendor's public reply to the review.
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([vendorId])
}

/// Field reports (daily update / task report / event report); replaces ActivityLog `FieldReport` rows.
model FieldReport {
  id               String          @id @default(uuid())
  type             FieldReportType
  weddingId        String?
  wedding          Wedding?        @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title            String
  summary          String?
  progress         Int?
  issues           String?
  nextSteps        String?
  taskId           String?
  eventId          String?
  event            WeddingEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  attendance       Int?
  photoDocumentIds String[]
  createdAt        DateTime        @default(now())

  @@index([weddingId, createdAt])
  @@index([authorId])
  @@index([type])
}

model MasterDataItem {
  id        String   @id @default(uuid())
  /// e.g. SERVICE_CATEGORY, EVENT_FUNCTION, VENDOR_CATEGORY, PACKAGE
  type      String
  code      String
  label     String
  meta      Json?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([type, code])
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model IntegrationConfig {
  id           String    @id @default(uuid())
  /// KEYCLOAK, SMTP, PAYMENT_GATEWAY, MAPS, ...
  provider     String    @unique
  enabled      Boolean   @default(false)
  config       Json      @default("{}")
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  updatedAt    DateTime  @updatedAt
}

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model BackupRecord {
  id            String       @id @default(uuid())
  status        BackupStatus @default(PENDING)
  kind          String       @default("MANUAL")
  objectKey     String?
  size          BigInt?
  note          String?
  triggeredById String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
}

model RolePermission {
  id      String  @id @default(uuid())
  role    Role
  module  String
  action  String
  allowed Boolean @default(true)

  @@unique([role, module, action])
  @@index([role])
}
