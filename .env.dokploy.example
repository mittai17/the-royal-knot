# ==============================================================================
# The Royal Knot - Dokploy Environment Variables (.env.dokploy.example)
#
# Copy and paste these variables into Dokploy:
# Project -> The Royal Knot -> Your Compose Service -> Environment Tab
#
# Replace every CHANGE_ME with secure generated values:
#   openssl rand -hex 32
# ==============================================================================

# --- Traefik & Domain Routing -------------------------------------------------
# Set BASE_DOMAIN to your root domain (e.g., royalknot.in or royalknot.example.com)
BASE_DOMAIN=royalknot.in
PUBLIC_APP_URL=https://app.royalknot.in
KEYCLOAK_PUBLIC_URL=https://auth.royalknot.in

# For HTTPS production: COOKIE_SECURE=true and TRAEFIK_ENTRYPOINT=websecure
# For local HTTP testing: COOKIE_SECURE=false and TRAEFIK_ENTRYPOINT=web
COOKIE_SECURE=true
TRAEFIK_ENTRYPOINT=websecure

# --- Single Postgres Database (3 Isolated DBs: royalknot, keycloak, hyperswitch) -
POSTGRES_USER=royalknot
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- App Auth & Security Secrets ----------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET_FOR_REFRESH_TOKEN
SEED_ON_START=true
SEED_FORCE=false
DEMO_PASSWORD=RoyalKnot@2026

# --- MinIO Object Storage (S3-compatible documents bucket) -------------------
MINIO_ROOT_USER=royalknot
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=royalknot-documents

# --- Keycloak 26 Identity Provider (Split-Horizon OIDC) -----------------------
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KC_API_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ENABLED=true

# --- Mailpit (Demo SMTP Server & Inbox) ---------------------------------------
# Basic auth credentials for mail.<BASE_DOMAIN> inspection inbox
MAILPIT_UI_AUTH=admin:RoyalKnot@2026
MAIL_FROM=no-reply@royalknot.in

# --- Indian Payments (Hyperswitch & RoyalPay UPI QR) --------------------------
UPI_VPA=royalknot@upi
ROUTER__DUMMY_CONNECTOR__ENABLED=true
HYPERSWITCH_URL=http://hyperswitch:8080

# --- Frontend Build Configuration ---------------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.royalknot.in
NEXT_PUBLIC_KEYCLOAK_REALM=royalknot
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=royalknot-web
NEXT_PUBLIC_DEMO_MODE=true

# --- Database Automated Backups -----------------------------------------------
BACKUP_SCHEDULE=@daily
